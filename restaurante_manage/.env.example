# MySQL Database
DB_URL=jdbc:mysql://localhost:3307/restaurant_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# JWT Configuration
# Obligatorio: mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
# NUNCA subas el valor real al repositorio.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# CORS — orígenes permitidos separados por comas (dominio real del frontend en prod)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server
PORT=8080

# Email (API HTTPS de Resend) — recuperación de contraseña y notificaciones
# de reserva. MAIL_ENABLED=false (por defecto) omite el envío real; útil en
# desarrollo sin proveedor. La API key se crea en https://resend.com/api-keys.
# Sin dominio propio verificado en Resend, MAIL_FROM debe ser
# onboarding@resend.dev (y solo entrega a tu propio email de la cuenta).
MAIL_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# Bootstrap del primer SUPER_ADMIN (solo entornos nuevos, p. ej. primer despliegue)
# Define las tres variables SOLO para el primer arranque: si ya existe un
# SUPER_ADMIN activo no hace nada y puedes retirarlas. Contraseña: mínimo 12 caracteres.
# NUNCA subas los valores reales al repositorio.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# true SOLO para recuperar el acceso: restablece la contraseña de la cuenta de
# bootstrap con el valor de BOOTSTRAP_ADMIN_PASSWORD en el siguiente arranque.
# Retirar después de usar.
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# Recuperación de contraseña
# Minutos de validez del enlace de reset (un solo uso, se invalida al generar uno nuevo).
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30
# Origen del frontend, usado para construir el enlace de recuperación.
FRONTEND_URL=http://localhost:5173

# Stripe (modo test en local). Obtener en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Lo imprime `stripe listen --forward-to localhost:8080/api/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# Identificadores de precio mensuales (price_...), no de producto (prod_...)
STRIPE_PRICE_NORMAL_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_TRIAL_DAYS=14
