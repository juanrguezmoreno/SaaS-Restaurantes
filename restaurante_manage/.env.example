# MySQL Database
DB_URL=jdbc:mysql://localhost:3307/restaurant_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# JWT Configuration
# Obligatorio: mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
# NUNCA subas el valor real al repositorio.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# CORS — orígenes permitidos separados por comas (dominio real del frontend en prod)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server
PORT=8080

# Email (SMTP) — notificaciones de reserva confirmada/cancelada
# MAIL_ENABLED=false (por defecto) hace que el envío se loguee en vez de
# realizarse de verdad; útil en desarrollo sin credenciales SMTP reales.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
